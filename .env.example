# ETC Eos / ETCnomad
EOS_HOST=127.0.0.1
EOS_PORT_TX=8000
EOS_PORT_RX=9001
EOS_RX_BIND=0.0.0.0
EOS_PROTOCOL=udp
# Real TCP OSC (Eos listens; MCP connects outbound — bidirectional, no separate RX port)
# EOS_PROTOCOL=tcp
# EOS_TCP_PORT=3032          # Native OSC TCP 1.0 (packet-length headers, ~1Hz /eos/out)
# EOS_TCP_PORT=3037          # Third Party OSC 1.1 SLIP (v3.1+, ~realtime /eos/out) — enable in Device/Network
# EOS_TCP_OSC_VERSION=1.0    # 1.0 = length headers | 1.1 = SLIP — must match Eos Setup TCP mode
# EOS_TCP_MODE=length        # length | slip (auto from port; overrides EOS_TCP_OSC_VERSION)
# Custom ports OK (ETC recommends 4703–4727+). Still enable OSC RX+TX in Setup.

# OSC user routing (-1 = match console, 0 = background, 1-99 = virtual user)
EOS_USER_ID=-1

# Safety (PLAN §8)
# Live writes (cues, levels, subs, faders, palettes, keys) need:
#   confirm=true when EOS_REQUIRE_CONFIRM=true
#   allow_live=true when the console is LIVE and EOS_ALLOW_LIVE=false
EOS_ALLOW_LIVE=false
EOS_REQUIRE_CONFIRM=true
# EOS_MAX_CUE_FIRES_PER_MIN=12
# EOS_AUDIT_LOG=./eos-mcp.audit.log

# Eos version hint for command syntax
EOS_VERSION=3.3.6
