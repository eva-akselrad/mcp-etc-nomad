# ETC Eos / ETCnomad
EOS_HOST=127.0.0.1
EOS_PORT_TX=8000
EOS_PORT_RX=9001
EOS_RX_BIND=0.0.0.0
EOS_PROTOCOL=udp
# TCP OSC (Eos listens; MCP connects outbound — no separate RX port)
# EOS_PROTOCOL=tcp
# EOS_TCP_PORT=3037          # Third Party OSC (SLIP, default)
# EOS_TCP_PORT=3032          # Native Eos TCP (OSC 1.0 length-prefixed)
# EOS_TCP_MODE=slip          # slip | length (auto: 3037→slip, 3032→length)

# OSC user routing (-1 = match console, 0 = background, 1-99 = virtual user)
EOS_USER_ID=-1

# Safety (PLAN §8)
# Live writes (cues, levels, subs, faders, palettes, keys) need:
#   confirm=true when EOS_REQUIRE_CONFIRM=true
#   allow_live=true when the console is LIVE and EOS_ALLOW_LIVE=false
EOS_ALLOW_LIVE=false
EOS_REQUIRE_CONFIRM=true
# EOS_MAX_CUE_FIRES_PER_MIN=12
# EOS_AUDIT_LOG=./eos-mcp.audit.log

# Eos version hint for command syntax
EOS_VERSION=3.3.6
