{
  "name": "mcp-etc-nomad",
  "version": "1.0.0",
  "description": "MCP server for ETC Eos Family lighting consoles (ETCnomad) via OSC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-etc-nomad": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "etc",
    "eos",
    "etcnomad",
    "lighting",
    "osc",
    "theatre"
  ],
  "author": "eva-akselrad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eva-akselrad/mcp-etc-nomad.git"
  },
  "bugs": {
    "url": "https://github.com/eva-akselrad/mcp-etc-nomad/issues"
  },
  "homepage": "https://github.com/eva-akselrad/mcp-etc-nomad#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "node-osc": "^11.0.0",
    "osc-min": "^2.1.2",
    "slip": "^1.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/slip": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
