{
  "name": "mcp-etc-nomad",
  "version": "0.3.0",
  "description": "MCP server for ETC Eos Family lighting consoles (ETCnomad) via OSC",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-etc-nomad": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "etc",
    "eos",
    "etcnomad",
    "lighting",
    "osc",
    "theatre"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "node-osc": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
